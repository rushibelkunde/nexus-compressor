#!/usr/bin/env bash
# ==============================================================================
# Nautilus / GNOME Files Script: Compress with NEXUS (.nxar)
# ==============================================================================

set -e

if ! command -v nexus >/dev/null 2>&1; then
    if [ -f "$HOME/.local/bin/nexus" ]; then
        export PATH="$HOME/.local/bin:$PATH"
    fi
fi

if ! command -v nexus >/dev/null 2>&1; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="NEXUS Not Found" --text="nexus executable not found in PATH or ~/.local/bin."
    else
        echo "Error: nexus executable not found."
    fi
    exit 1
fi

for item in "$@"; do
    if [ -e "$item" ]; then
        nexus compress "$item"
    fi
done

if command -v notify-send >/dev/null 2>&1; then
    notify-send "NEXUS" "Compression completed successfully!" -i package-x-generic
fi
